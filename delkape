                    <div class="absolute -bottom-6 -left-6 bg-white py-3 px-5 rounded-2xl shadow-xl border border-stone-100 flex items-center gap-3">
                 
                        <div>
                            <p class="text-xs text-stone-400 font-medium uppercase tracking-wider">Starting at</p>
          
