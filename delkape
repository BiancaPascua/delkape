                    <div>
                        <p class="font-bold text-matcha-900 text-base md:text-lg">Fresh</p>
                        <p class="text-xs text-stone-500 font-medium">Steamed Per Batch</p>
                    </div>
                    <div>
                        <p class="font-bold text-matcha-900 text-base md:text-lg">Artisan</p>
                        <p class="text-xs text-stone-500 font-medium">Muscovado & Coconut</p>
