                    <div class="absolute -inset-4 bg-matcha-200/50 rounded-3xl blur-2xl -z-10"></div>
                    
                    <div class="overflow-hidden rounded-3xl bg-stone-100 border border-stone-200/80 shadow-2xl">
                    
                        <img 
                            src="https://uploads.onecompiler.io/452wk8cr8/1792738777792/Your%20paragraph%20text.png" 
                            alt="Matcha Puto Bumbong" 
                            class="w-full h-[450px] object-cover hover:scale-105 transition-transform duration-500 ease-out"
